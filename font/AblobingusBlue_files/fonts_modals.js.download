var EditFontForm = {
    font: m.prop(),


    tried_to_save: m.prop(false),
    error_message: m.prop(),

    validate: function () {
        EditFontForm.tried_to_save(true);
        EditFontForm.font().name = EditFontForm.font().name.trim();
        if (EditFontForm.font().name.length === 0) {
            EditFontForm.error_message(pl.t('Font name can\'t be empty.'));
            return false;
        }

        if (!EditFontForm.font().id && fonts_module.fonts()
            && filter_obj_by_prop_value(fonts_module.fonts(), 'name', EditFontForm.font().name).length > 0) {
            EditFontForm.error_message(pl.t('There already exists a font with this name.'));
            return false;
        }
        return true;
    },

    save: function () {
        Fonts.save(EditFontForm.font()).then(
            function (fontId) {
                Modal.module(null);
                fonts_sidedrawer.updateFontsList().then(function () {
                    return Fonts.byId(fontId).then(
                        function (font) {
                            return fonts_module.switch_active_font(font).then(m.redraw);
                        }
                    );
                });

            },
            // Problem: For some errors (which again, constraints?) we have a translation. But for unexpected errors we
            // would completly swallow all errors. Therefore we do a error log here, but we will also log expected
            // errors.
            function (e) {
                EditFontForm.error_message(e.error || e.message || String(e));
                m.redraw();
                throw e; // Rethrow the error to be caught by global handlers
            }
        );
    },

    controller: function (font_to_edit) {
        EditFontForm.tried_to_save(false);
        EditFontForm.error_message(undefined);
        if (font_to_edit) {
            // we added the Fonts.create_new() so we get the default values for newly introduced Font properties.
            EditFontForm.font(Object.assign({}, Fonts.create_new(), font_to_edit))
        }
        else {
            EditFontForm.font(Fonts.create_new())
        }
    },

    view: function (ctrl) {
        var available_styles = ["Regular", "Bold", "Italic", "Bold Italic"];

        var main_panel_content = [
            m('div', {style: {height: '1.5em'}}, ' '),
            m(__mdl_helper.text_field, {
                label: pl.t('Font name'),
                id: 'editfontform-font-name',
                binding: set_get_for_property(EditFontForm.font(), 'name'),
                additional_configs: {
                    pattern: ".{1,}",
                    maxlength: 32
                },
                options: {
                    is_required: EditFontForm.tried_to_save(),
                    error_message: EditFontForm.error_message(),
                    default_error_message: pl.t('Font name can\'t be empty.')
                }
            }),

            m(__mdl_helper.slider_percent, {
                id: 'editfontform-default-advance',
                label: pl.t('Letter spacing'),
                val: set_get_for_property(EditFontForm.font(), 'default_glyph_advance'),
                min: 0,
                max: 3,
                step: 0.01,
                showMinMax: true,
                showValue: true,
                tooltip: pl.t('Edit font dialog font default advance tooltip')
            }),

            m(__mdl_helper.slider_percent, {
                id: 'editfontform-scale-factor',
                label: pl.t('Font size'),
                val: set_get_for_property(EditFontForm.font(), 'scale_factor'),
                min: 0.25,
                max: 2.75,
                step: 0.01,
                showMinMax: true,
                showValue: true,
                tooltip: pl.t('Edit font dialog font scale tool tip')
            }),

            m(__mdl_helper.slider, {
                id: 'editfontform-word-spacing',
                label: pl.t('Word spacing'),
                val: set_get_for_property(EditFontForm.font(), 'word_spacing'),
                min: 0,
                max: 1000,
                step: 10,
                showMinMax: false,
                showValue: false,
                tooltip: pl.t('edit_font_dialog_tooltip_word_spacing')
            }),
        ];

        var maxlen = 98;
        var textfields_config = [
            ['Copyright notice', 'copyright', maxlen],
            // ['Trademark note', 'trademark', maxlen],
            ['Manufacturer name', 'manufacturer', maxlen],
            ['Designer name', 'designer', maxlen],
            ['Description', 'description', 99],
            // ['Vendor Url', 'vendor_url', maxlen],
            ['Licence description', 'licence_desc', 300],
            // ['Licence Url', 'licence_url', maxlen],

        ];

        var meta_panel_content = [
            window.fe_user.is_upgraded
                ? null
                : m('#metapanel-upgraded-only-overlay',
                    m('#metapanel-upgraded-only-content',
                        pl.t('Editing metadata is available for upgraded accounts.'))
                ),
            m('#style-selector-wrap', [
                m('label', pl.t('Font style')),
                m("select#style-selector-select",
                    {onchange: m.withAttr('value', set_get_for_property(EditFontForm.font(), 'style'))},
                    [
                        available_styles.map(function (style, index) {
                            return m("option",
                                {
                                    value: style,
                                    selected: EditFontForm.font().style == style
                                },
                                style
                            );
                        })
                    ])
            ]),

            // Version
            m(__mdl_helper.text_field, {
                label: pl.t('Version'),
                id: 'editfontform-font-version',
                binding: set_get_for_property(EditFontForm.font(), 'font_version'),
                additional_configs: {pattern: "[0-9](\.[0-9]{1,3})?"},
                options: {
                    is_required: EditFontForm.tried_to_save(),
                    error_message: EditFontForm.error_message(),
                    default_error_message: pl.t('Please enter a number between 1.000 and 9.999')
                }
            }),
            textfields_config.map(function(cnf) {
                if (cnf[2] > maxlen ) {
                    return m('.mdl-textfield.mdl-js-textfield.mdl-textfield--floating-label', [
                        m('textarea.mdl-textfield__input#editfontform-font-'+cnf[1],
                        {
                            type: "text", rows: "2", maxlength: cnf[2],
                            onchange: m.withAttr('value', set_get_for_property(EditFontForm.font(), cnf[1])),
                        },
                        EditFontForm.font()[cnf[1]]
                    ),
                        m('label.mdl-textfield__label', { for: 'editfontform-font-'+cnf[1] }, pl.t(cnf[0]) )
                    ])
                }
                else {
                    return m(__mdl_helper.text_field, {
                        label: pl.t(cnf[0]),
                        id: 'editfontform-font-'+cnf[1],
                        binding: set_get_for_property(EditFontForm.font(), cnf[1]),
                        additional_configs: {maxlength: cnf[2]},
                    })
                }
            })

        ];

        return [
            m('.form#editfontform',
                [
                    m("h3", pl.t(EditFontForm.font().id ? "Edit font details" : "Create new font")),

                    m("div.mdl-tabs.mdl-js-tabs", [
                        m(".mdl-tabs__tab-bar", [
                            m('a[href=#main_panel].mdl-tabs__tab.is-active',
                                {
                                    // Without the following hack the metapanel stays visible because the is-active
                                    // class doesn't get removed. For some stange reason the metapanel isn't in the
                                    // DOM when mdl upgrades elements.
                                    onclick: function() {document.getElementById('meta_panel').classList.remove('is-active')}
                                },
                                pl.t('Main')),
                            m('a[href=#meta_panel].mdl-tabs__tab', pl.t('Metadata'))
                        ]),
                        m('div', {style: {height: '1em'}}, ' '),

                        m("#main_panel.mdl-tabs__panel.is-active", main_panel_content),
                        m("#meta_panel.mdl-tabs__panel", meta_panel_content),


                    ]),

                    m(__mdl_helper.form_buttons, {
                        action_func: EditFontForm.save.bind(this),
                        action_label: pl.t("Save"),
                        validator: EditFontForm.validate
                    })
                ]
            )
        ]
    }
};
