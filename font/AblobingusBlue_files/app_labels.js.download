var snippets = {};
snippets['template_dashboard'] = ' \
<h3>What to do next:</h3> \
<ol>\
<li>Create your template by choosing a complete character set on the left or compiling a personalized template with arbritrary characters.</li> \
<li>Click on a character to remove it. Use the bin icon in the upper right to remove all characters.</li>\
<li>When you are happy with your template, click on <b>\'Download Template\'</b>.</li> \
<li>Your template will be created and become available for download via the provided link.</li> \
</ol>\
';

snippets['dashboard'] = ' <div id="main-dashboard-first-steps"\
<h3>Your first steps:</h3> \
<ol id="first-steps-list">\
<li><a href="?/templates">Create a template</a> and print it out.</li> \
<li>Fill it out.</li> \
<li>Use a scanner, digital camera or a smartphone to capture your filled-out template.</li> \
<li>On the <a href="?/fonts">fonts page</a>, choose the <b>\'Upload template\'</b> option and upload your image file.</li> \
<li>Finally, click on <b>\'Build font\'</b> and enjoy your font!</li>\
</ol></div>\
';

snippets['font_dashboard'] = ' \
<h3>No fonts yet</h3> \
<p>You have not created any fonts yet. To do so, <a href="?/templates">create a template</a>, fill it out and scan or take a photo of it.</p> \
<p>If you already have an image of your template, click on <b>\'Upload Template\'</b> in the toolbar at the top.</p>\
';

snippets['addjust_baseline_dialog_shortcuts'] = ' \
    <b>Keyboard shortcuts</b><br> \
    <table> \
        <tr><td>left/right</td><td>Shift chars to the left/right.</td></tr> \
        <tr><td>up/down</td><td>Adjust character up/down.</td></tr> \
        <tr><td>Shift + up/down&nbsp;&nbsp;</td><td>Adjust character up/down (more).</td></tr> \
        <tr><td>Shift + left/right&nbsp;&nbsp;</td><td>Select character to the left/right.</td></tr> \
        <tr><td>+/-</td><td>Scale character up/down.</td></tr> \
        <tr><td>s</td><td>Shuffle</td></tr> \
    </table>';


snippets['bad_result_hint'] = ' \
    <b>Result isn\'t satisfying?</b> \
    If the resulting font has defects take a look at the '
    + faq_link('faq-common-problems', "'How to fix common problems'") + ' section of our FAQ.';

snippets['no_template_detected_hint'] = ' \
<br>Please make sure, that\
<ul style="list-style-type: square; list-style-position: inside;">\
<li>Your image includes all four markers (those nested rectangles in the corners).</li> \
<li>The markers and the QRCode are not garbled. For instance by a shadow or a printer out of ink.</li> \
<li>That you use a template created with Calligraphr, not a template from MyScriptFont, PaintFont or from our Quicktest.</li> \
</ul> \
If your template fulfils all of the above requirements and still isn\'t detected please send the template to us (info@calligraphr.com) and we will look if we can improve our processing.\
    ';