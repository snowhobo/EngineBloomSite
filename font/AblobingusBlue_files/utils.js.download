function create_uuid() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
    });
}

/**
 * Throws and Error if there are more then one objects with the given property value.
 * @param array_of_objects
 * @param property
 * @param value
 * @returns {*}
 */
function get_obj_by_prop_value(array_of_objects, property, value) {
    if (typeof array_of_objects === 'undefined') {
        window.jsLogger && window.jsLogger.warn("get_obj_by_prop_value received undefined for array. prop:" + property + " value:" + value);
        return undefined;
    }
    var all_found = array_of_objects.filter(function (obj) {
        return obj[property] === value;
    });
    if (all_found.length === 0) {
        return undefined;
    } else if (all_found.length > 1) {
        throw Error(sprintf("Found %s items with a property %s of %s.", all_found.length, property, value));
    }
    return all_found[0]
}

function filter_obj_by_prop_value(array_of_objects, property, value) {
    return array_of_objects.filter(function (obj) {
        return obj[property] === value;
    });
}


function remove_obj_by_prop_value(array_of_objects, property, value) {
    return array_of_objects.filter(function (obj) {
        return obj[property] !== value;
    });
}


function sleepFor(sleepDuration) {
    var now = new Date().getTime();
    while (new Date().getTime() < now + sleepDuration) { /* do nothing */
    }
}


/**
 * Enhanced fetch function with timeout, retry logic, and error handling
 * @param {string} url - The URL to fetch
 * @param {string} type - The HTTP method (GET, POST, PUT, DELETE)
 * @param {Object|FormData} data - The data to send with the request
 * @param {Object} options - Additional options
 * @param {number} options.timeout - Request timeout in milliseconds (default: 30000)
 * @param {number} options.retries - Number of retry attempts (default: 2)
 * @param {number} options.retryDelay - Delay between retries in milliseconds (default: 1000)
 * @returns {Promise} - Promise resolving to the response data
 */
function do_fetch(url, type, data, options = {}) {
    const {
        timeout = 90000,
        retries = 2,
        retryDelay = 1000
    } = options;
    
    let attempt = 0;
    
    function executeRequest() {
        attempt++;
        
        var headers = {
            "X-CSRFToken": Cookies.get("csrftoken"),
            'Accept': 'application/json, text/*'
        };

        if (!(data instanceof FormData)) {
            headers['content-type'] = 'application/json';
            data = JSON.stringify(data);
        }

        var request_config = {
            headers: headers,
            credentials: 'same-origin',
            method: type,
            referrerPolicy: 'no-referrer-when-downgrade'
        };

        if (type === 'POST' || type === 'PUT') {
            request_config['body'] = data;
        }

        if (url !== '/webapp/poll_for_result/') {
            window.jsLogger && window.jsLogger.debug("fetch", {
                url: url, 
                request_type: type,
                attempt: attempt
            });
        }
        
        // Create a timeout promise that rejects after the specified time
        const timeoutPromise = new Promise((_, reject) => {
            setTimeout(() => {
                reject(new Error(`Request timeout after ${timeout}ms`));
            }, timeout);
        });
        
        // Race the fetch against the timeout
        return Promise.race([
            fetch(url, request_config),
            timeoutPromise
        ])
        .then(function(response) {
            if (response.status === 403) {
                window.jsLogger && window.jsLogger.warn("403 for fetch.", {url: url});
                // Reloading to force login
                window.location.reload(true);
                return false;     // not sure if necessary.
            }

            if (!response.ok) {
                // For 5xx errors, we might want to retry
                if (response.status >= 500 && response.status < 600 && attempt <= retries) {
                    window.jsLogger && window.jsLogger.warn("Server error, retrying...", {
                        url: response.url,
                        status: response.status,
                        attempt: attempt,
                        maxRetries: retries
                    });
                    
                    return new Promise(resolve => {
                        setTimeout(() => resolve(executeRequest()), retryDelay * attempt);
                    });
                }
                
                window.jsLogger && window.jsLogger.error("do_fetch() Error Response", {
                    url: response.url,
                    status: response.status,
                    statusText: response.statusText,
                    attempt: attempt
                });
                return {error: response.statusText};
            }

            if (type === 'DELETE' && response.status === 204) {
                return "";
            }

            var contentType = response.headers.get("content-type");
            if (contentType && contentType.includes("application/json")) {
                return response.json();
            }

            return response.text().then(function(text) {
                window.jsLogger && window.jsLogger.warn("Unexpected response type", {
                    url: response.url,
                    status: response.status,
                    contentType: contentType,
                    text: text.substring(0, 100) // Log only first 100 chars
                });
                return text;
            });
        })
        .catch(function(error) {
            // Network errors or timeouts - retry if we have attempts left
            if (attempt <= retries && 
                (error.name === 'TypeError' || error.message.includes('timeout'))) {
                window.jsLogger && window.jsLogger.warn("Network error, retrying...", {
                    url: url,
                    error: error.message,
                    attempt: attempt,
                    maxRetries: retries
                });
                
                return new Promise(resolve => {
                    setTimeout(() => resolve(executeRequest()), retryDelay * attempt);
                });
            }
            
            window.jsLogger && window.jsLogger.error("fetch error in do_fetch()", {
                url: url,
                request_type: type,
                name: error.name,
                message: error.message,
                stack: error.stack,
                attempt: attempt
            });
            throw(error);
        });
    }
    
    return executeRequest();
}

/**
 * Wrapper for POST requests
 * @param {string} url - The URL to fetch
 * @param {Object|FormData} data - The data to send
 * @param {Object} options - Additional options (timeout, retries, retryDelay)
 * @returns {Promise} - Promise resolving to the response data
 */
function fetch_post(url, data, options = {}) {
    return do_fetch(url, 'POST', data, options);
}

/**
 * Wrapper for GET requests
 * @param {string} url - The URL to fetch
 * @param {Object} options - Additional options (timeout, retries, retryDelay)
 * @returns {Promise} - Promise resolving to the response data
 */
function fetch_get(url, options = {}) {
    return do_fetch(url, 'GET', null, options);
}

function set_get_for_property(obj, property_name) {
    return function (value) {
        if (value) {
            obj[property_name] = value;
        } else {
            return obj[property_name];
        }
    }
}

function normalize_unicode(string) {
    return string.normalize('NFC');
}

function remove_diacretics(str) {
    // normalize()ing to NFD Unicode normal form decomposes combined graphemes into the combination of simple ones.
    // The è of Crème ends up expressed as e + ̀.
    // Using a regex character class to match the U+0300 → U+036F range, to globally get rid of the diacritics,
    // which the Unicode standard conveniently groups as the Combining Diacritical Marks Unicode block.
    return str.normalize('NFD').replace(/[\u0300-\u036f]/g, "")
}

function isObject(obj) {
    return obj === Object(obj);
}

compareObjectsOneLevel = function (o1, o2) {
    for (var p in o1) {
        if (o1.hasOwnProperty(p)) {
            if (o1[p] !== o2[p]) {
                return false;
            }
        }
    }
    for (var p in o2) {
        if (o2.hasOwnProperty(p)) {
            if (o1[p] !== o2[p]) {
                return false;
            }
        }
    }
    return true;
};

function arrayRotate(arr, reverse) {
    if (reverse)
        arr.unshift(arr.pop());
    else
        arr.push(arr.shift());
    return arr
}

function arrayRotateByCount(arr, count) {
    count -= arr.length * Math.floor(count / arr.length);
    arr.push.apply(arr, arr.splice(0, count));
    return arr
}

/**
 * Shuffles array in place.
 * @param {Array} a items The array containing the items.
 */
function shuffleArray(a) {
    var j, x, i;
    for (i = a.length; i; i--) {
        j = Math.floor(Math.random() * i);
        x = a[i - 1];
        a[i - 1] = a[j];
        a[j] = x;
    }
}

function uniqueArraySorted(array) {
    var temp = array.reduce(function (previous, current) {
        previous[current] = true;
        return previous;
    }, {});

    return Object.keys(temp).sort();
}

function uniqueArray(array) {
    var temp = array.reduce(function (previous, current) {
        previous[current] = true;
        return previous;
    }, {});

    return Object.keys(temp);
}

// Stringify with circular protecxtion and max size limit.
stringifyOnce = function (obj, replacer, indent) {
    var printedObjects = [];
    var printedObjectKeys = [];

    function printOnceReplacer(key, value) {
        if (printedObjects.length > 100) { // browsers will not print more than 20K, I don't see the point to allow 2K.. algorithm will not be fast anyway if we have too many objects
            return 'object too long';
        }
        var printedObjIndex = false;
        printedObjects.forEach(function (obj, index) {
            if (obj === value) {
                printedObjIndex = index;
            }
        });

        if (key === '') { //root element
            printedObjects.push(obj);
            printedObjectKeys.push("root");
            return value;
        } else if (printedObjIndex + "" !== "false" && typeof (value) === "object") {
            if (printedObjectKeys[printedObjIndex] === "root") {
                return "(pointer to root)";
            } else {
                return "(see " + ((!!value && !!value.constructor) ? value.constructor.name.toLowerCase() : typeof (value)) + " with key " + printedObjectKeys[printedObjIndex] + ")";
            }
        } else {

            var qualifiedKey = key || "(empty key)";
            printedObjects.push(value);
            printedObjectKeys.push(qualifiedKey);
            if (replacer) {
                return replacer(key, value);
            } else {
                return value;
            }
        }
    }

    return JSON.stringify(obj, printOnceReplacer, indent);
};
