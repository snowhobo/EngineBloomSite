// Enables setting properties instead of functions in inlined event handlers
// see https://gist.github.com/mindeavor/0bf02f1f21c72de9fb49
m.setValue = function (obj, prop) {
    return m.withAttr('value', function (value) {
        obj[prop] = value
    })
};


function convertToSlug(Text) {
    return Text
        .toLowerCase()
        .replace(/[^\w ]+/g, '')
        .replace(/ +/g, '-')
        ;
}

function capitalizeFirstLetter(string) {
    return string.charAt(0).toUpperCase() + string.slice(1);
}

function updateMdl() {
    if (window && window.componentHandler) {
        window.componentHandler.upgradeDom();
    }
}

function make_rand_string() {
    var text = "";
    var possible = "abcdefghijklmnopqrstuvwxyz";
    for (var i = 0; i < 10; i++)
        text += possible.charAt(Math.floor(Math.random() * possible.length));
    return text;
}


function clear_properties_of_object(obj) {
    var vm_props = Object.getOwnPropertyNames(obj);
    for (var i = 0; i < vm_props.length; i++) {
        obj[vm_props[i]](null);
    }
}


function slugify(text) {
    return text.toString().toLowerCase()
        .replace(/\s+/g, '-')           // Replace spaces with -
        .replace(/[^\w\-]+/g, '')       // Remove all non-word chars
        .replace(/\-\-+/g, '-')         // Replace multiple - with single -
        .replace(/^-+/, '')             // Trim - from start of text
        .replace(/-+$/, '');            // Trim - from end of text
}


/**
 * Creates the views for the different stages of a polling view. form -> processing -> result or error.
 * result and form have to provided, processing and error are generic.
 * @param is_request_send_func
 * @param form_view_func
 * @param error_func
 * @param result_func
 * @param result_view_func
 * @returns {*}
 */
function polling_view(is_request_send_func, form_view_func, error_func, result_func, result_view_func) {
    if (!is_request_send_func()) {
        return form_view_func();
    } else {
        if (error_func()) {
            var error_key = undefined;
            var dict = {};

            var error_obj = error_func();
            // If it is not an object check if it is JSON represantion of an error.
            if (!isObject(error_func())) {
                try {
                    error_obj = JSON.parse(error_func());
                } catch (e) {
                    window.jsLogger && window.jsLogger.debug("polling_view: Could not parse as json: " + error_func)
                }
            }
            // If the error object is an object and has an error object get the error atrribute.
            // If this error object contains an Array it is for the ployglot replacement function.
            // Eg. ["error desc %{repl1} %{repl2}", {repl1: 'asdsads', repl2: 'sds'}]
            if (isObject(error_obj) && error_obj.hasOwnProperty("error")) {
                error_key = error_obj.error;
                if (Array.isArray(error_obj.error)) {
                    error_key = error_obj.error[0];
                    dict = error_obj.error[1];
                }
            } else {
                error_key = error_obj;

            }
            var msg = pl.t('An unexpected server error happened. Please try again.');
            if (pl.has(error_key)) {
                msg = pl.t(error_key, dict);
            } else {
                window.jsLogger && window.jsLogger.info('polling_view(): Unexpected error object ' + error_obj + '  error_key: ' + error_key)
            }

            var msg_header = pl.t(error_key + '_header', {'_': pl.t('Oops! Something went wrong.')});

            return m('.error-message-wrap', [
                m('h3', msg_header),
                m(".error-message", m.trust(msg)),
                build_message_buttons()
            ])
        } else if (result_func()) {
            return result_view_func();
        } else {
            return [m("h3.waiting-header", pl.t("Processing")),
                // m('.waiting-spinner-wrap',  m('span', m(".mdl-spinner.mdl-js-spinner.mdl-spinner--single-color.is-active") ) )
                build_centered_spinner(pl.t('Please wait.'))
            ]
        }
    }

}


/**
 * Wrapper around send_request and poll_for_result. Used to include error handling.
 * For params see send_request and poll_for_result
 */
function start_polling_request(url,
                               data,
                               finished_prop_func,
                               error_prop_func,
                               result_prop_func,
                               callback) {

    window.jsLogger && window.jsLogger.debug('start_polling_request', {url: url});

    fetch_post(url, data)
        .then(
            function (result) {
                if (result.hasOwnProperty('error')) {
                    error_prop_func(result.error);
                    m.redraw(true);
                } else {
                    poll_for_result(result.jobId, finished_prop_func, error_prop_func, result_prop_func, callback);
                }
            }
        );
}


/**
 * Helper method to poll for queued jobs results.
 * The URL to be polled is expected to return:
 * return JsonResponse({
        'finished': job.result is not None or job.is_failed is True,
        'is_failed': job.is_failed,
        'result': job.result,
    })
 * @param job_id Job Id to poll for.
 * @param finished_prop_func Function to set current finished state (True or False). Will be called multiple times.
 * @param error_prop_func Function to set error message.
 * @param result_prop_func Function to set result of job.
 * @param callback, Optional, will be called, with job.result as parameter, if failed or successful.
 */
function poll_for_result(job_id, finished_prop_func, error_prop_func, result_prop_func, callback) {
    var time_out = 670 * 1000;      // Should be at least QUEUE_TTL+PRCESSING_TIMEOUT, see web/webapp/create_error_entry_view.py

    var url = "/webapp/poll_for_result/";       // todo4: read from config, written by django in app_home.html
    var msAtStart = new Date().getTime();

    var pollFunc = function () {
        // Check for timeout
        var msCurrent = new Date().getTime();
        var timeTakenYet = msCurrent - msAtStart;
        if (timeTakenYet > time_out) {
            // window.jsLogger && window.jsLogger.warn(sprintf("poll_for_result.pollFunc: Timed out after %s: jobid: %s", time_out, job_id));
            window.jsLogger && window.jsLogger.info('poll_for_result.pollFunc: Timed out', {
                jobid: job_id,
                after_s: timeTakenYet
            });
            error_prop_func('Result_polling_timed_out');
            m.redraw();
            return;
        }

        fetch_post(url,
            {
                jobId: job_id,
                is_upgraded: window.fe_user.is_upgraded
            })
            .then(function (job) {
                window.jsLogger && window.jsLogger.debug("poll_for_result fetch_post.then():", job);

                if (!job.hasOwnProperty('finished')) {
                    window.jsLogger && window.jsLogger.warn("Resulting job has no expected 'finished' property " + job)
                }

                finished_prop_func(job.finished);

                if (job.error) {
                    error_prop_func(job.error);
                } else if (job.finished) {
                    if (job.is_failed) {        // old: use the above job.error condition track and remove this
                        error_prop_func(true);
                    } else if (job.result && job.result.error) {    // for expected errors like wrong filetypes uploaded. We have error message here.
                        error_prop_func({error: job.result.error})
                    } else {
                        result_prop_func(job.result);
                    }
                    if (callback) {
                        callback(job.result);
                    }
                    m.redraw(true);
                } else {
                    // increment time to wait between polling every time
                    var time_to_wait = 2000 + Math.min(parseInt(timeTakenYet / 10), 4000);
                    setTimeout(pollFunc, time_to_wait);
                }
            })
    };
    setTimeout(pollFunc, 2500);
}


function range_from_to(start, end) {
    var r = [];
    for (var i = start; i <= end; i++) {
        r.push(i);
    }
    return r;
}

// Use this function instead of checking with length to check if a glyph is singe char or ligature
// see https://mathiasbynens.be/notes/javascript-unicode
var regexAstralSymbols = /[\uD800-\uDBFF][\uDC00-\uDFFF]/g;

function countSymbols(string) {
    return string
        // Replace every surrogate pair with a BMP symbol.
        .replace(regexAstralSymbols, '_')
        // …and *then* get the length.
        .length;
}

//
// function countSymbols(string) {
//     // see https://mathiasbynens.be/notes/javascript-unicode
//     return punycode.ucs2.decode(string).length;
// }


// see https://mathiasbynens.be/notes/javascript-unicode
function splitUnicode(string) {
    var index = 0;
    var length = string.length;
    var output = [];
    for (; index < length - 1; ++index) {
        var charCode = string.charCodeAt(index);
        if (charCode >= 0xD800 && charCode <= 0xDBFF) {
            charCode = string.charCodeAt(index + 1);
            if (charCode >= 0xDC00 && charCode <= 0xDFFF) {
                output.push(string.slice(index, index + 2));
                ++index;
                continue;
            }
        }
        output.push(string.charAt(index));
    }
    output.push(string.charAt(index));
    return output;
}

