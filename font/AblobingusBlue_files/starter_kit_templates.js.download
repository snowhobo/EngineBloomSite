
var stk_alpha_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
stk_alpha_chars += stk_alpha_chars.toLowerCase();
var stk_number_chars = "0123456789";
// stk_base_chars = stk_alpha_chars + stk_number_chars+ "\"=.,;:!?'“-()@+/&%";
var stk_base_chars = stk_alpha_chars+",.?!:;\"'";

function english_chars() {
    return stk_base_chars;
}
function german_chars() {
    return stk_base_chars + "üöäÜÖÄß" + '¨';
}
function french_chars() {
    var dias = "éèçëòôöùàâêî";
    return stk_base_chars + dias + dias.toUpperCase()+"«»"+"´`ˆ¨¸";
}
function spanish_chars() {
    var dias = "áéíóúñ";
    return stk_base_chars + dias + dias.toUpperCase() + '¿¡' + '◌̃´¨';
}



var starter_kit_templates = {
    "en": english_chars(),
    "de": german_chars(),
    "fr": french_chars(),
    "es": spanish_chars(),
    "ja": '、・ヱヰゑゐエッアカサタナハマヤラワンイキシチニヒミリウクスツヌフムユルェケセテネヘメレオコソトノホモヨロヲガザダバパギジヂビピグズヅブプヴゲゼデベペゴゾドボポあかさたなはまやらわんいきしちにひみりうくすつぬふむゆるえけせてねへめれおこそとのほもよろをがざだばぱぎじぢびぴぐずづぶぷげぜでべぺごぞどぼぽぁぃぅぇぉっゃゅょァィゥェォャュョ一二三四五六七八九十日大年中会人本月長国出上生子分東行同今高金時手見市力米自前円合立内事社者地京間田体学下目五後新明方部女心民対主正代言小思山実入回場野開万全定家北問話文動度県水安氏和政保表道相意発不党神様響流派手光千愛夢未来壊如矢物語川井桜蘭高校部皿乙益个艸。°ლღω「」『』【】《》«»〘〙￥・ー♪♫♩♬♡♥☆★✪✿彡¬◑◕●εゝ☂…⊙﹏≡╯╰︵⌒∇△◎〃◇',
    "Numbers": stk_number_chars,
