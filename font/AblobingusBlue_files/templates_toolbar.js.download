var templates_toolbar = {


    view: function () {
        return m('div', [
            // m("#calli-toolbar-icons", [
            //     m('button.mdl-button.mdl-js-button.mdl-button--icon',
            //         {
            //             onclick: templates_module.glyphs().length > 0
