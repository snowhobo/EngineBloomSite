var templates_content = {

    working: false,

    controller: function () {
        templates_content.working = true;
        templates_module.update_current_units().then(function() {
            templates_content.working = false;
            m.redraw(true);
        });
    },

    make_glyphbox: function (glyph) {
        var char_name = "";
        if (glyph.unit.length === 1) {
            var hex = glyph.unit.codePointAt(0).toString(16).toUpperCase();
            hex = ("0000" + hex).slice(-4);
            char_name = "U+"+hex;
            if (hex in char_names_selection) {
                char_name = char_name + ': ' + char_names_selection[hex]
            }
        }

        var is_new = templates_module.new_glyphs.indexOf(glyph.unit)>=0;
        var config = {
            onclick: templates_content.delete_glyph_from_template.bind(this, glyph),
        };

        var wrap_class = '';
        if (is_new) {
            wrap_class = ".new-element";
        }
        return m("li.card.card-1"+wrap_class, {title: char_name}, [
            m(".glyph-wrap.clickable", config, glyph.unit)
        ])
    },

    delete_glyph_from_template: function (glyph) {
        show_are_your_sure_dialog({
            text: pl.t("Do you want to delete this glyph from your template?"),
            button_label: pl.t("Delete"),
            dontaskagain_key: 'delete_glyph_from_template_content',
            action_function: templates_module.remove_glyph.bind(this, glyph)
        });
        // Modal.module(AreYouSureDialog, {
        //     text: "Do you want to delete this glyph from your template?",
        //     button_label: "Delete",
        //     dontaskagain_key: 'delete_glyph_from_template_content',
        //     action_function: templates_module.remove_glyph.bind(this, glyph)
        // });
    },

    view: function () {
        if (templates_content.working) {
            return build_centered_spinner(pl.t('Just a moment ...'))
        }

        var ligas = templates_module.glyphs().filter(function (item) {
            return countSymbols(item.unit) > 1;
        });

        var glyphs = templates_module.glyphs().filter(function (item) {
            return countSymbols(item.unit) == 1;
        });

        var is_max_number_plan_reached = templates_module.glyphs()
            && templates_module.glyphs().length > window.gn_config.plan_limits.nr_glyphs;

        var is_max_number_abs_reached = templates_module.glyphs()
            && templates_module.glyphs().length > window.gn_config.max_limits.nr_glyphs;


        // List of template glyphs
        return m("div", [

            is_max_number_abs_reached
                ? build_message_box(
                    pl.t('max_number_glyphs_abs_reached',
                        {
                            max_nr: window.gn_config.max_limits.nr_glyphs,
                            current: templates_module.glyphs().length,
                        })
                )
                : null,

            // don't show the max plan warning if user is on the pro account, because the is_max_number_abs_reached
            // warning will already be shown.
            is_max_number_plan_reached && window.gn_config.current_plan.toLowerCase() != 'pro'
                ? build_message_box(
                    pl.t('max_number_glyphs_reached_plan_template',
                        {
                            max_nr: window.gn_config.plan_limits.nr_glyphs,
                            current: templates_module.glyphs().length,
                            plan: window.gn_config.current_plan
                        })
                    + '<br>' + pl.t('enjoy_pro_version_by_upgrading', { upgrade_url:  window.fe_urls.upgrade_url })
                )
                : null,

            glyphs.length + ligas.length === 0
                ? m("#templates-dashboard.dashboard-block", m.trust(snippets.template_dashboard))   // no glyphs yet.
                : m("ul#templates-glyphs-list", [
                    glyphs.map(function (glyph) {
                    return templates_content.make_glyphbox(glyph)
                })
            ]),

            ligas.length > 0
                ? m(".ligas-list", [
                m("h3", pl.t("Ligatures")),
                !window.fe_user.is_upgraded
                    ? build_message_box(pl.t('ligatures_pro_only_will_ignore'))
                    : null,
                m("ul#templates-ligas-list", [
                    ligas.map(function (liga) {
                        return templates_content.make_glyphbox(liga)
                    })
                ])
            ])
                : null,
        ])

    }
};